{
  "name": "point-game",
  "version": "1.0.0",
  "description": "Точки — классическая стратегическая игра",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/",
    "server:dev": "node --loader ts-node/esm server/index.ts",
    "server:build": "tsc --project tsconfig.server.json"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
